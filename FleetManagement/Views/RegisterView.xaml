<Window x:Class="FleetManagement.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register User"
        Height="480" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Border CornerRadius="10"
            Background="White"
            Padding="25"
            Margin="20">

        <StackPanel>
            <TextBlock Text="Rola"/>
            <ComboBox ItemsSource="{Binding Roles}"
              SelectedItem="{Binding SelectedRole}"
              Height="35"
              Margin="0,5,0,15"/>

            <TextBlock Text="Username"/>
            <TextBox Text="{Binding Username}"
             Height="35"
             Margin="0,5,0,15"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox"
                 Height="35"
                 Margin="0,5,0,15"
                 PasswordChanged="PasswordBox_PasswordChanged"/>

            <StackPanel Visibility="{Binding IsVozacSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Broj licence"/>
                <TextBox Text="{Binding BrojLicence}"
             Height="35"
             Margin="0,5,0,15"/>
            </StackPanel>

            <Button Content="Register"
            Height="40"
            Background="#2ECC71"
            Foreground="White"
            FontWeight="Bold"
            Command="{Binding RegisterCommand}"
            Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
