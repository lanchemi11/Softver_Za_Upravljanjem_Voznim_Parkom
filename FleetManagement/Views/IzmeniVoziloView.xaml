<Window x:Class="FleetManagement.Views.IzmeniVoziloView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmeni Vozilo" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Forma za izmenu -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Marka:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelektovanoVozilo.Marka, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Model:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelektovanoVozilo.Model, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Godina:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelektovanoVozilo.GodinaProizvodnje, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Registracija:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelektovanoVozilo.Registracija, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Status:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelektovanoVozilo.Status, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        </Grid>

        <!-- Dugmad -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Sačuvaj" Width="100" Margin="5" Command="{Binding SacuvajIzmeneCommand}"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Content="Otkaži" Width="100" Margin="5" Click="Otkaži_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>