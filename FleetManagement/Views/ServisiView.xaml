<Window x:Class="FleetManagement.Views.ServisiView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pregled Servisa" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pregled Servisa"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"
                   Grid.Row="0"/>

        <DataGrid ItemsSource="{Binding Servisi}" 
                  SelectedItem="{Binding SelektovaniServis}"
                  AutoGenerateColumns="False"
                  Grid.Row="1"
                  AlternatingRowBackground="#eeeeee"
                  RowBackground="White"
                  BorderBrush="#cccccc"
                  BorderThickness="1"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="2*"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=d}" Width="*"/>
                <DataGridTextColumn Header="Vozilo ID" Binding="{Binding VoziloId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel HorizontalAlignment="Center" Margin="10" Grid.Row="2">
            <Button Content="➕ Dodaj" Command="{Binding OtvoriDodajServisCommand}" Width="100" Margin="5"
            Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="✏️ Izmeni" Command="{Binding OtvoriIzmeniServisCommand}" Width="100" Margin="5"
            Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Content="🗑️ Obriši" Command="{Binding ObrisiServisCommand}" Width="100" Margin="5"
            Background="#F44336" Foreground="White" FontWeight="Bold"/>
            <Button Content="📄 Izveštaj Servisi" Command="{Binding IzvestajServisiPoVoziluCommand}" Width="150" Margin="5"
            Background="#FF9800" Foreground="White" FontWeight="Bold"/>
            <Button Content="📊 Broj Servisa" Command="{Binding IzvestajBrojServisaCommand}" Width="150" Margin="5"
            Background="#9C27B0" Foreground="White" FontWeight="Bold"/>
            <Button Content="📤 Export" Command="{Binding ExportServisiCommand}" Width="100" Margin="5"
            Background="#009688" Foreground="White" FontWeight="Bold"/>
            <Button Content="📥 Import" Command="{Binding ImportServisiCommand}" Width="100" Margin="5"
            Background="#FF5722" Foreground="White" FontWeight="Bold"/>
        </WrapPanel>
    </Grid>
</Window>