<Window x:Class="FleetManagement.Views.IzmeniServisView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmeni Servis" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Forma -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Opis:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelektovaniServis.Opis, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Datum:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding SelektovaniServis.Datum, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Vozilo:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
              ItemsSource="{Binding Vozila}" 
              SelectedItem="{Binding IzabranoVozilo}"
              DisplayMemberPath="Registracija"
              Margin="5"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Sačuvaj" Width="100" Margin="5" Command="{Binding SacuvajIzmeneServisCommand}"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Content="Otkaži" Width="100" Margin="5" Click="Otkaži_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>