<Window x:Class="FleetManagement.Views.VozilaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pregled vozila" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pregled svih vozila"
               FontSize="20" FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"
               Grid.Row="0"/>

        <Border Grid.Row="1" 
        Background="#f0f0f0" 
        CornerRadius="5" 
        Padding="10" 
        Margin="0,0,0,10" 
        BorderBrush="#cccccc" 
        BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Pretraga vozila:" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0"/>
                <TextBox Width="250"
                 Height="28"
                 Padding="5,0"
                 BorderBrush="#999999"
                 BorderThickness="1"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding VozilaView}"  
              SelectedItem="{Binding SelektovanoVozilo}"
              AutoGenerateColumns="False"
              Grid.Row="2"
              AlternatingRowBackground="#eeeeee"
              RowBackground="White"
              BorderBrush="#cccccc"
              BorderThickness="1"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="*" />
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="Godina" Binding="{Binding GodinaProizvodnje}" Width="*" />
                <DataGridTextColumn Header="Registracija" Binding="{Binding Registracija}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" Grid.Row="3">
            <Button Content="➕ Dodaj" Command="{Binding OtvoriDodajFormuCommand}" Width="100" Margin="5"
                Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="✏️ Izmeni" Command="{Binding OtvoriIzmeniFormuCommand}" Width="100" Margin="5"
                Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Content="🗑️ Obriši" Command="{Binding ObrisiVoziloCommand}" Width="100" Margin="5"
                Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>