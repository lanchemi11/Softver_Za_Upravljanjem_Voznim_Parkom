<Window x:Class="FleetManagement.Views.DodajVoziloView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FleetManagement.Views"
        mc:Ignorable="d"
        Title="DodajVoziloView" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Forma za unos -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Marka -->
            <Label Grid.Row="0" Grid.Column="0" Content="Marka:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NovoVozilo.Marka, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Model -->
            <Label Grid.Row="1" Grid.Column="0" Content="Model:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NovoVozilo.Model, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Godina -->
            <Label Grid.Row="2" Grid.Column="0" Content="Godina proizvodnje:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NovoVozilo.GodinaProizvodnje, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Registracija -->
            <Label Grid.Row="3" Grid.Column="0" Content="Registracija:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NovoVozilo.Registracija, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Status -->
            <Label Grid.Row="4" Grid.Column="0" Content="Status:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NovoVozilo.Status, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        </Grid>

        <!-- Dugmad -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Sačuvaj" Width="100" Margin="5" Command="{Binding DodajVoziloCommand}"
                Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Otkaži" Width="100" Margin="5" Click="Otkaži_Click"
                Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>

</Window>
